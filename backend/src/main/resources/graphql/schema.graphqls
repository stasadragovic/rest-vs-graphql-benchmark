type Query {
    projects(limit: Int! = 20): [Project!]!
    project(id: ID!): Project
    task(id: ID!): Task
    users(ids: [ID!]): [User!]!
    user(id: ID!): User
}

type Mutation {
    createTask(projectId: ID!, input: CreateTaskInput!): Task!
    updateTask(id: ID!, input: UpdateTaskInput!): Task!
    updateTaskStatus(id: ID!, status: TaskStatus!): Task!
    deleteTask(id: ID!): Boolean!
    updateComment(id: ID!, text: String!): Comment!
    deleteComment(id: ID!): Boolean!
}

input CreateTaskInput {
    title: String!
    description: String
    priority: Int
    assigneeId: ID
    dueDate: String
}

input UpdateTaskInput {
    title: String!
    description: String
    status: TaskStatus!
    priority: Int!
    assigneeId: ID
    dueDate: String
}

type Project {
    id: ID!
    name: String!
    description: String
    createdAt: String!
    owner: User!
    tasks: [Task!]!
}

type Task {
    id: ID!
    title: String!
    description: String
    status: TaskStatus!
    priority: Int!
    dueDate: String
    createdAt: String!
    updatedAt: String!
    project: Project!
    assignee: User
    comments: [Comment!]!
}

enum TaskStatus {
    TODO
    IN_PROGRESS
    DONE
}

type Comment {
    id: ID!
    text: String!
    createdAt: String!
    task: Task!
    author: User!
}

type User {
    id: ID!
    name: String!
    email: String!
    createdAt: String!
    assignedTasks: [Task!]!
}
